---
/**
 * The header every page wears: the mark, the name, and the way into the tool.
 *
 * The ring in the mark is the score dial the app draws, stopped at a good
 * score — `stroke-dasharray="80 27"` leaves the same gap the arc leaves at 87.
 */
---

<header>
  <div class="wrap">
    <a class="brand" href="/">
      <svg class="mark" viewBox="0 0 40 40" aria-hidden="true">
        <circle cx="20" cy="20" r="17" fill="none" stroke="rgba(79,182,217,.2)" stroke-width="4" />
        <circle
          cx="20" cy="20" r="17" fill="none" stroke="#2FE0C8" stroke-width="4"
          stroke-linecap="round" stroke-dasharray="80 27" transform="rotate(-90 20 20)"
        />
      </svg>
      <span>BassScore<small>PÊCHE AU BAR</small></span>
    </a>
    <a class="header-link" href="/app/">Ouvrir l’outil →</a>
  </div>
</header>
