---
/**
 * An editorial guide: the landing page's head, plus the three schema.org blocks
 * a guide carries and the breadcrumb it opens with.
 *
 * All three blocks are built here rather than written into the page. They were
 * 55 lines of JSON per guide restating what the page already said — the place,
 * its coordinates, its URL, the publisher — and every one of them was a chance
 * to leave a neighbour's coordinates behind after a copy-paste. What is left
 * for the page to supply is what is genuinely its own: its title, its two
 * descriptions, its questions and its prose.
 *
 * It renders a spot guide and a topic guide the same way, and does not know
 * which it was handed: `subjectOf()` answers what the breadcrumb ends on, what
 * the headline says and what the article is about, and those are the only three
 * places the two kinds differ.
 */
import BaseLayout from './BaseLayout.astro';
import { pathOf, SITE_URL, subjectOf, urlOf } from '../data/guides.mjs';

import '../styles/guide.css';

interface Props {
  /** Which guide this is. Everything about its subject comes from its entry. */
  slug: string;
  /** `<title>`, `og:title` and `twitter:title`. */
  title: string;
  /** The search snippet. */
  description: string;
  /** The share-card snippet. */
  social: string;
  /** The questions Google may show under the result, in the page's own words. */
  faq: { question: string; answer: string }[];
}

const { slug, title, description, social, faq } = Astro.props;
const { crumb, headline, about } = subjectOf(slug);

const url = urlOf(slug);

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Pêche au bar', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: crumb, item: url },
  ],
};

const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  // Both the headline and what the article is about come from the route table:
  // a spot guide's are a template over its place, a topic guide's are its own.
  headline,
  inLanguage: 'fr-FR',
  url,
  mainEntityOfPage: url,
  image: `${SITE_URL}/og-image.png`,
  about,
  publisher: { '@type': 'Organization', name: 'BassScore', url: `${SITE_URL}/` },
};

const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  social={social}
  path={pathOf(slug)}
  ogType="article"
  current={slug}
>
  <Fragment slot="schema">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbs)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(article)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqPage)} />
  </Fragment>

  <article>
    <section class="hero">
      <div class="wrap">
        <nav class="crumbs" aria-label="Fil d’Ariane">
          <ol>
            <li><a href="/">Pêche au bar</a></li>
            <li>{crumb}</li>
          </ol>
        </nav>

        <slot name="hero" />
      </div>
    </section>

    <slot />
  </article>

  <slot name="closing" />
</BaseLayout>
