---
/**
 * An editorial guide: the landing page's head, plus the three schema.org blocks
 * a guide carries and the breadcrumb it opens with.
 *
 * All three blocks are built here rather than written into the page. They were
 * 55 lines of JSON per guide restating what the page already said — the place,
 * its coordinates, its URL, the publisher — and every one of them was a chance
 * to leave a neighbour's coordinates behind after a copy-paste. What is left
 * for the page to supply is what is genuinely its own: its title, its two
 * descriptions, its questions and its prose.
 */
import BaseLayout from './BaseLayout.astro';
import { guideBySlug, pathOf, SITE_URL, urlOf } from '../data/guides.mjs';

import '../styles/guide.css';

interface Props {
  /** Which guide this is. Everything about the place comes from its entry. */
  slug: string;
  /** `<title>`, `og:title` and `twitter:title`. */
  title: string;
  /** The search snippet. */
  description: string;
  /** The share-card snippet. */
  social: string;
  /** The questions Google may show under the result, in the page's own words. */
  faq: { question: string; answer: string }[];
}

const { slug, title, description, social, faq } = Astro.props;
const { place, preposition, kind, region, geo } = guideBySlug(slug);

const url = urlOf(slug);

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Pêche au bar', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: place, item: url },
  ],
};

const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  // The one headline shape all six share. A guide that ever needs its own says
  // so with a prop; until one does, this is what keeps them in step.
  headline: `Pêche au bar ${preposition} ${place} : meilleurs horaires et conditions`,
  inLanguage: 'fr-FR',
  url,
  mainEntityOfPage: url,
  image: `${SITE_URL}/og-image.png`,
  about: {
    '@type': 'Place',
    name: place,
    address: {
      '@type': 'PostalAddress',
      // A region page has no locality to name — only the region itself.
      ...(kind === 'commune' ? { addressLocality: place } : {}),
      addressRegion: region,
      addressCountry: 'FR',
    },
    geo: { '@type': 'GeoCoordinates', ...geo },
  },
  publisher: { '@type': 'Organization', name: 'BassScore', url: `${SITE_URL}/` },
};

const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: { '@type': 'Answer', text: answer },
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  social={social}
  path={pathOf(slug)}
  ogType="article"
  current={slug}
>
  <Fragment slot="schema">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbs)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(article)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqPage)} />
  </Fragment>

  <article>
    <section class="hero">
      <div class="wrap">
        <nav class="crumbs" aria-label="Fil d’Ariane">
          <ol>
            <li><a href="/">Pêche au bar</a></li>
            <li>{place}</li>
          </ol>
        </nav>

        <slot name="hero" />
      </div>
    </section>

    <slot />
  </article>

  <slot name="closing" />
</BaseLayout>
